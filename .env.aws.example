# Sentry & Logging
SENTRY_DSN=https://...
LOG_TO_FILE=True/False

FAKER_USER_PASSWORD=Pass7$

# Celery & Redis
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
REDIS_CACHE_URL=redis://127.0.0.1:6379/1

# --- E2E Testing Configuration ---
# Mode: api or ui
E2E_TEST_MODE=api

# Target Base URL (Optional). Leave empty to use pytest-django live_server automatically.
# Fill in (e.g., https://staging.example.com) to run black-box tests against an external staging/prod environment.
E2E_BASE_URL=
